# ==============================================================================
# PDF Suite Environment Configuration Template
# ==============================================================================
# NOTE: PDF Suite is a 100% in-browser, client-side application.
# Sensitive private keys, database credentials, or secret tokens MUST NEVER be
# placed in client-facing bundles or committed to git.
#
# If backend companion microservices (e.g. OCR server, webhook handlers,
# rate-limited API proxies) are added, configure them via environment variables below:
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Rate Limiting Controls (for companion API services)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100

RATE_LIMIT_AUTHED_WINDOW_MS=900000
RATE_LIMIT_AUTHED_MAX=600

# Optional External Service Integrations (Backend Only - NEVER expose to browser)
# OCR_API_KEY=your_ocr_api_key_here
# SENTRY_DSN=your_backend_sentry_dsn
